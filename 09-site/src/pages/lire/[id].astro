---
import Page from '../../layouts/Page.astro';
import PlanFlottant from '../../composants/PlanFlottant.astro';
import { assainir } from '../../../outils/assainir.mjs';
import textes from '../../../donnees/textes.json';
import ancres from '../../../donnees/lieux.json';

export function getStaticPaths() {
  return textes.map((t, i) => ({
    params: { id: t.id },
    props: { texte: t, precedent: textes[i - 1] ?? null, suivant: textes[i + 1] ?? null },
  }));
}

const { texte, precedent, suivant } = Astro.props;

/* Chaque lieu a une portee : il tient du paragraphe qui le nomme jusqu'au
   suivant, puis la page se recentre. Sans portee, le texte resterait
   decentre tout le chapitre et le plan redeviendrait un meuble. */
const lieux = ancres.filter((a) => a.texte === texte.id);
const portees = lieux.map((a, n) => ({
  lieu: a.lieu,
  de: a.bloc,
  a: n + 1 < lieux.length ? lieux[n + 1].bloc - 1 : Math.min(a.bloc + 12, texte.p.length - 1),
}));

/* Les sequences : l'autrice a deja pose les coupures avec ses « · · · ».
   On ne les invente pas, on les prend au serieux. */
const sequences = [];
{
  let courante = [];
  texte.p.forEach((bloc, i) => {
    if (bloc[0] === 'pause') { sequences.push(courante); courante = []; }
    else courante.push({ bloc, i });
  });
  sequences.push(courante);
}

const mots = texte.p
  .filter(([balise]) => balise !== 'pause')
  .map(([, s]) => s).join(' ').replace(/<[^>]+>/g, '')
  .split(/\s+/).filter(Boolean).length;
---
<Page titre={`${texte.titre} — L'Éclaircie`} vue="lecture">
  <header class="chapeau">
    <h1>{texte.titre}</h1>
    <p class="sous">{texte.rang} · {mots.toLocaleString('fr-FR')} mots</p>
    <div class="outils">
      {precedent && <a class="puce" data-va="precedent" href={`/lire/${precedent.id}/`}>← {precedent.rang}</a>}
      <a class="puce" data-va="sommaire" href="/">Sommaire</a>
      {suivant && <a class="puce" data-va="suivant" href={`/lire/${suivant.id}/`}>{suivant.rang} →</a>}
    </div>
  </header>

  {lieux.length > 0 && <PlanFlottant lieux={lieux} />}

  <article class="texte" data-texte data-portees={JSON.stringify(portees)}>
    {sequences.map((seq, n) => (
      <section class="sequence">
        {n > 0 && <p class="pause" aria-hidden="true">· · ·</p>}
        {seq.map(({ bloc: [balise, contenu, classe], i }) => (
          <p
            class={[balise === 'tiret' ? 'tiret' : null, classe].filter(Boolean).join(' ')}
            data-bloc={i}
            set:html={assainir(contenu)}
          />
        ))}
      </section>
    ))}

    <nav class="fin-de-texte">
      {precedent
        ? <a class="pas" href={`/lire/${precedent.id}/`}><span class="etiq">Avant</span><b>{precedent.titre}</b></a>
        : <span></span>}
      {suivant
        ? <a class="pas droite" href={`/lire/${suivant.id}/`}><span class="etiq">Ensuite</span><b>{suivant.titre}</b></a>
        : <span class="pas droite muet"><span class="etiq">Ensuite</span><b>Pas encore écrit</b></span>}
    </nav>
  </article>
</Page>

<style>
  /* La colonne garde TOUJOURS la meme largeur : elle se translate, elle ne
     se redimensionne jamais. Les coupures de ligne ne bougent donc pas, et
     l'oeil ne perd pas sa ligne quand la page fait de la place au plan. */
  .texte {
    max-width: var(--mesure);
    margin: 0 auto;
    padding: 4.5rem 1.5rem 7rem;
    transition: transform 1.2s cubic-bezier(.22, .85, .26, 1);
  }

  .sequence {
    scroll-snap-align: start;
    scroll-margin-top: 5.5rem;
  }

  .texte p { margin: 0 0 1.35em; text-wrap: pretty; }
  .tiret { text-indent: 0; }
  /* Une respiration avant le dernier paragraphe, comme dans l'atelier. */
  .fin { margin-top: 1.6em; }

  /* La coupure de l'autrice. C'est de la ponctuation de recit. */
  .pause {
    text-align: center; color: var(--texte-4); letter-spacing: .6em;
    margin: 5.5rem 0 4.5rem; user-select: none; font-size: .9rem;
  }

  .fin-de-texte {
    display: flex; justify-content: space-between; gap: 14px;
    /* De l'air avant la sortie : le chapitre ne se termine pas colle au
       bas de l'ecran, et les dernieres ancres ont la place de remonter
       jusqu'a la ligne de decision. */
    margin-top: 40vh; padding-top: 2rem; border-top: 1px solid var(--trait);
  }
  .pas {
    display: block; text-decoration: none; padding: 12px 16px;
    background: var(--fond-3); border: 1px solid var(--trait);
    clip-path: polygon(0 0, calc(100% - 11px) 0, 100% 11px, 100% 100%, 11px 100%, 0 calc(100% - 11px));
    transition: transform .18s cubic-bezier(.2, .8, .3, 1), border-color .18s, background .18s;
  }
  .pas.droite { text-align: right; }
  .pas b { display: block; font-weight: 400; font-size: 1rem; margin-top: 3px; }
  .pas:hover { transform: translateY(-3px); border-color: var(--trait-fort); background: var(--fond-4); }
  .pas:hover b { color: var(--accent); }
  .muet { opacity: .5; }
  .muet:hover { transform: none; border-color: var(--trait); background: var(--fond-3); }
  .muet b { color: var(--texte-3); }

  @media (prefers-reduced-motion: reduce) {
    .texte, .pas { transition: none; }
    .pas:hover { transform: none; }
  }
</style>

<script>
  /* La page fait de la place au plan, puis la reprend.
     Tout est facultatif : sans ce script, la colonne reste centree et le
     plan n'apparait jamais — le roman se lit exactement pareil. */
  function mettreEnScene() {
    const colonne = document.querySelector('[data-texte]');
    const plan = document.querySelector('[data-plan]');
    if (!colonne || !plan) return;

    const portees = JSON.parse(colonne.dataset.portees || '[]');
    if (!portees.length) return;

    const vue = plan.querySelector('[data-vue]');
    const nom = plan.querySelector('[data-nom-lieu]');
    const svg = plan.querySelector('svg');
    const vb = svg.viewBox.baseVal;

    /* Le cadrage de chaque piece, calcule une fois. */
    const cadres = new Map();
    for (const forme of plan.querySelectorAll('.halo')) {
      const l = forme.dataset.lieu;
      const b = forme.getBBox();
      const a = cadres.get(l);
      cadres.set(l, a ? {
        x: Math.min(a.x, b.x), y: Math.min(a.y, b.y),
        X: Math.max(a.X, b.x + b.width), Y: Math.max(a.Y, b.y + b.height),
      } : { x: b.x, y: b.y, X: b.x + b.width, Y: b.y + b.height });
    }

    const cadrage = (lieu) => {
      const c = cadres.get(lieu);
      if (!c) return '';
      const lb = c.X - c.x, hb = c.Y - c.y;
      const plein = Math.min(vb.width / lb, vb.height / hb);
      const k = Math.max(1, Math.min(3.4, plein * 0.34));
      const tx = (vb.x + vb.width / 2) - k * (c.x + lb / 2);
      const ty = (vb.y + vb.height / 2) - k * (c.y + hb / 2);
      return `translate(${tx.toFixed(1)}px, ${ty.toFixed(1)}px) scale(${k.toFixed(3)})`;
    };

    const blocs = new Map();
    for (const p of colonne.querySelectorAll('p[data-bloc]')) blocs.set(+p.dataset.bloc, p);

    let lieuCourant = null;

    const jouer = () => {
      /* La ligne de decision est haute dans l'ecran : on bascule quand le
         paragraphe declencheur arrive en haut, pas quand il est au milieu.
         L'oeil n'a pas encore commence a lire cette zone. */
      /* Au tout dernier ecran, plus rien ne peut remonter : on abaisse la
         ligne, sinon un lieu nomme dans les dernieres lignes ne parait
         jamais. */
      const bas = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4;
      const ligne = bas ? window.innerHeight : window.innerHeight * 0.34;

      let vise = null;
      for (const p of portees) {
        const debut = blocs.get(p.de), fin = blocs.get(p.a);
        if (!debut) continue;
        const hautDebut = debut.getBoundingClientRect().top;
        const basFin = fin ? fin.getBoundingClientRect().bottom : hautDebut;
        if (hautDebut < ligne && basFin > 0) vise = p.lieu;
      }

      if (vise === lieuCourant) return;
      lieuCourant = vise;

      if (!vise) {
        plan.classList.remove('la');
        plan.setAttribute('aria-hidden', 'true');
        colonne.style.transform = '';
        for (const f of plan.querySelectorAll('.halo')) f.classList.remove('ici');
        return;
      }

      /* De combien la colonne s'ecarte : de quoi centrer l'ensemble
         colonne + plan, sans jamais sortir de l'ecran. */
      const large = plan.getBoundingClientRect().width;
      const scene = document.querySelector('.scene');
      const dispo = scene ? scene.getBoundingClientRect().width : window.innerWidth;
      const ecart = Math.min(large * 0.5 + 24, Math.max(0, (dispo - colonne.offsetWidth) / 2 - 24));

      colonne.style.transform = `translateX(${(-ecart).toFixed(0)}px)`;
      plan.classList.add('la');
      plan.setAttribute('aria-hidden', 'false');

      vue.style.transform = cadrage(vise);
      nom.textContent = vise;

      for (const f of plan.querySelectorAll('.halo')) {
        f.classList.remove('ici');
        if (f.dataset.lieu === vise) { void f.getBoundingClientRect(); f.classList.add('ici'); }
      }
    };

    window.addEventListener('scroll', jouer, { passive: true });
    window.addEventListener('resize', jouer, { passive: true });
    jouer();
  }

  mettreEnScene();
  document.addEventListener('astro:page-load', mettreEnScene);
</script>
