---
import Page from '../../layouts/Page.astro';
import PlanSource from '../../composants/PlanSource.astro';
import Plaque from '../../composants/Plaque.astro';
import { assainir } from '../../../outils/assainir.mjs';
import textes from '../../../donnees/textes.json';
import ancres from '../../../donnees/lieux.json';

export function getStaticPaths() {
  return textes.map((t, i) => ({
    params: { id: t.id },
    props: { texte: t, precedent: textes[i - 1] ?? null, suivant: textes[i + 1] ?? null },
  }));
}

const { texte, precedent, suivant } = Astro.props;

/* La planche vient APRES le paragraphe qui nomme le lieu : le plan ne
   montre que ce que le texte a deja dit. Il n'annonce rien, il fait echo. */
const lieux = ancres.filter((a) => a.texte === texte.id);
const parBloc = new Map(lieux.map((a) => [a.bloc, a.lieu]));

/* Les sequences : l'autrice a deja pose les coupures avec ses « · · · ».
   On ne les invente pas, on les prend au serieux — chacune devient une
   section, et c'est la qu'on peut respirer et s'accrocher au defilement. */
const sequences = [];
{
  let courante = [];
  texte.p.forEach((bloc, i) => {
    if (bloc[0] === 'pause') { sequences.push(courante); courante = []; }
    else courante.push({ bloc, i });
  });
  sequences.push(courante);
}

const mots = texte.p
  .filter(([balise]) => balise !== 'pause')
  .map(([, s]) => s).join(' ').replace(/<[^>]+>/g, '')
  .split(/\s+/).filter(Boolean).length;
---
<Page titre={`${texte.titre} — L'Éclaircie`} vue="lecture">
  <header class="chapeau">
    <h1>{texte.titre}</h1>
    <p class="sous">{texte.rang} · {mots.toLocaleString('fr-FR')} mots</p>
    <div class="outils">
      {precedent && <a class="puce" data-va="precedent" href={`/lire/${precedent.id}/`}>← {precedent.rang}</a>}
      <a class="puce" data-va="sommaire" href="/">Sommaire</a>
      {suivant && <a class="puce" data-va="suivant" href={`/lire/${suivant.id}/`}>{suivant.rang} →</a>}
    </div>
  </header>

  {lieux.length > 0 && <PlanSource />}

  <article class="texte">
    {sequences.map((seq, n) => (
      <section class="sequence">
        {n > 0 && <p class="pause" aria-hidden="true">· · ·</p>}
        {seq.map(({ bloc: [balise, contenu, classe], i }) => (
          <>
            <p
              class={[balise === 'tiret' ? 'tiret' : null, classe].filter(Boolean).join(' ')}
              set:html={assainir(contenu)}
            />
            {parBloc.has(i) && <Plaque lieu={parBloc.get(i)} />}
          </>
        ))}
      </section>
    ))}

    <nav class="fin-de-texte">
      {precedent
        ? <a class="pas" href={`/lire/${precedent.id}/`}><span class="etiq">Avant</span><b>{precedent.titre}</b></a>
        : <span></span>}
      {suivant
        ? <a class="pas droite" href={`/lire/${suivant.id}/`}><span class="etiq">Ensuite</span><b>{suivant.titre}</b></a>
        : <span class="pas droite muet"><span class="etiq">Ensuite</span><b>Pas encore écrit</b></span>}
    </nav>
  </article>
</Page>

<style>
  /* La colonne de lecture, et les planches qui la traversent de bord a bord.
     Les sequences reprennent la grille du parent (subgrid) pour que les
     planches gardent le droit de sortir de la colonne. */
  .texte {
    display: grid;
    grid-template-columns: 1fr min(var(--mesure), calc(100% - 3rem)) 1fr;
    padding: 4.5rem 0 7rem;
  }
  .texte > :global(*) { grid-column: 2; }

  .sequence {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    /* On s'accroche ici, en douceur : au debut d'une sequence, jamais
       au milieu d'un paragraphe. */
    scroll-snap-align: start;
    scroll-margin-top: 5.5rem;
  }
  .sequence > :global(*) { grid-column: 2; }
  .sequence > :global(.plaque) { grid-column: 1 / -1; }

  .texte p { margin: 0 0 1.35em; text-wrap: pretty; }
  .tiret { text-indent: 0; }
  /* Une respiration avant le dernier paragraphe, comme dans l'atelier. */
  .fin { margin-top: 1.6em; }

  /* La coupure de l'autrice. C'est de la ponctuation de recit : on lui
     donne l'air qu'elle demande. */
  .pause {
    text-align: center; color: var(--texte-4); letter-spacing: .6em;
    margin: 5.5rem 0 4.5rem; user-select: none; font-size: .9rem;
  }

  .fin-de-texte {
    display: flex; justify-content: space-between; gap: 14px;
    margin-top: 5rem; padding-top: 2rem; border-top: 1px solid var(--trait);
  }
  .pas {
    display: block; text-decoration: none; padding: 12px 16px;
    background: var(--fond-3); border: 1px solid var(--trait);
    clip-path: polygon(0 0, calc(100% - 11px) 0, 100% 11px, 100% 100%, 11px 100%, 0 calc(100% - 11px));
    transition: transform .18s cubic-bezier(.2, .8, .3, 1), border-color .18s, background .18s;
  }
  .pas.droite { text-align: right; }
  .pas b { display: block; font-weight: 400; font-size: 1rem; margin-top: 3px; }
  .pas:hover { transform: translateY(-3px); border-color: var(--trait-fort); background: var(--fond-4); }
  .pas:hover b { color: var(--accent); }
  .muet { opacity: .5; }
  .muet:hover { transform: none; border-color: var(--trait); background: var(--fond-3); }
  .muet b { color: var(--texte-3); }

  @media (prefers-reduced-motion: reduce) {
    .pas { transition: none; }
    .pas:hover { transform: none; }
  }
</style>

<script>
  /* Chaque planche se cadre sur son lieu et se dessine quand on arrive dessus.
     Sans ce script, le plan reste entier et lisible, et le texte ne bouge pas. */
  function animerLesPlanches() {
    const planches = document.querySelectorAll('[data-plaque]:not([data-prete])');
    if (!planches.length) return;

    const cadrer = (planche) => {
      const svg = planche.querySelector('svg');
      const vue = planche.querySelector('[data-vue]');
      const formes = planche.querySelectorAll('.halo');
      if (!svg || !vue || !formes.length) return;

      const vb = svg.viewBox.baseVal;
      let c = null;
      for (const f of formes) {
        const b = f.getBBox();
        c = c ? {
          x: Math.min(c.x, b.x), y: Math.min(c.y, b.y),
          X: Math.max(c.X, b.x + b.width), Y: Math.max(c.Y, b.y + b.height),
        } : { x: b.x, y: b.y, X: b.x + b.width, Y: b.y + b.height };
      }

      /* La planche est large : on cadre sur la largeur visible, pas sur le viewBox. */
      const r = svg.getBoundingClientRect();
      const vus = { l: vb.height * (r.width / r.height), h: vb.height };

      const lb = c.X - c.x, hb = c.Y - c.y;
      /* La piece doit occuper environ un tiers du cadre, qu'elle soit
         l'accueil ou une salle de ceremonie : on part de son ajustement
         plein cadre et on recule d'autant. */
      const plein = Math.min(vus.l / lb, vus.h / hb);
      const k = Math.max(1, Math.min(4.5, plein * 0.32));
      const tx = (vb.x + vb.width / 2) - k * (c.x + lb / 2);
      const ty = (vb.y + vb.height / 2) - k * (c.y + hb / 2);

      /* On pose le point de depart un cran plus large, pour que l'arrivee se voie. */
      vue.style.transform = `translate(${(tx * .55).toFixed(1)}px, ${(ty * .55).toFixed(1)}px) scale(${(1 + (k - 1) * .35).toFixed(3)})`;
      planche.dataset.arrivee = `translate(${tx.toFixed(1)}px, ${ty.toFixed(1)}px) scale(${k.toFixed(3)})`;
      planche.dataset.prete = '1';
    };

    /* La planche se devoile quand elle entre franchement dans la vue.
       Au defilement plutot qu'a l'IntersectionObserver : meme resultat, une
       API de moins, et ca se verifie sans compositeur. */
    const devoiler = () => {
      const h = window.innerHeight;
      for (const p of planches) {
        if (p.classList.contains('vu')) continue;
        const r = p.getBoundingClientRect();
        if (r.top < h * 0.8 && r.bottom > h * 0.2) {
          const vue = p.querySelector('[data-vue]');
          if (vue && p.dataset.arrivee) vue.style.transform = p.dataset.arrivee;
          p.classList.add('vu');
        }
      }
    };

    for (const p of planches) cadrer(p);
    window.addEventListener('scroll', devoiler, { passive: true });
    window.addEventListener('resize', devoiler, { passive: true });
    devoiler();
  }

  animerLesPlanches();
  document.addEventListener('astro:page-load', animerLesPlanches);
</script>
