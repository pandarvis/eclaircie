---
/* La geometrie de la ruche, posee une seule fois dans la page.
   Les planches s'y referent par <use> : un seul dessin, plusieurs vues. */
import ruche from '../../donnees/ruche.json';

const ATTRS_PORTES = new Set([
  'd', 'x', 'y', 'cx', 'cy', 'r', 'rx', 'ry', 'width', 'height', 'points', 'transform',
  'class', 'fill', 'stroke', 'stroke-width', 'stroke-linecap', 'stroke-linejoin',
  'stroke-dasharray', 'stroke-opacity', 'fill-opacity', 'opacity', 'filter', 'style',
  'text-anchor', 'id', 'font-size', 'letter-spacing',
]);

const echapper = (v) => String(v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');

function tracer(n) {
  const attrs = Object.entries(n.attrs)
    .filter(([k]) => ATTRS_PORTES.has(k))
    .map(([k, v]) => `${k}="${echapper(v)}"`).join(' ');
  const dedans = (n.enfants || []).map(tracer).join('') + (n.texte ? echapper(n.texte) : '');
  return `<${n.tag}${attrs ? ' ' + attrs : ''}>${dedans}</${n.tag}>`;
}
---
<svg class="source-ruche" aria-hidden="true" width="0" height="0">
  <g id="ruche" set:html={ruche.dessin.map(tracer).join('')} />
</svg>

<style is:global>
  .source-ruche { position: absolute; width: 0; height: 0; overflow: hidden; }

  /* L'habillage de son dessin, porte dans les deux themes. */
  .plaque svg { --or: #D9A441; --vert: #7FB069; --bleu: #0081B3; }
  .plaque .caps { opacity: .5; }
  .plaque .zone { display: none; }
  .plaque .etiq {
    font-family: var(--sans); font-size: 9.5px; letter-spacing: .24em;
    text-transform: uppercase; fill: var(--texte-3); pointer-events: none;
  }
  .plaque .etiq.petite { font-size: 8px; letter-spacing: .18em; }
  .plaque .coulee {
    fill: none; stroke: var(--vert); stroke-width: 2.6; stroke-linecap: round;
    opacity: .4; stroke-dasharray: 16 13;
  }
  .plaque .coulee.fine { stroke-width: 1.5; opacity: .25; }
  .plaque .mur { fill: none; stroke: var(--trait-fort); stroke-width: 1.5; }

  /* Les halos sont injectes par set:html : Astro ne leur pose pas son
     attribut de portee, donc leurs regles vivent ici, en global.
     Etat par defaut = visible ; c'est html.js qui commence par effacer. */
  .plaque .halo {
    fill: var(--accent); fill-opacity: .13;
    stroke: var(--accent); stroke-width: 2.5;
    vector-effect: non-scaling-stroke;
  }
  html.js .plaque .halo {
    fill-opacity: 0; stroke-dasharray: 1; stroke-dashoffset: 1;
  }
  html.js .plaque.vu .halo {
    animation: tracer 1.5s .5s cubic-bezier(.3, .7, .2, 1) forwards,
               emplir 1.2s 1.5s ease-out forwards;
  }
  @keyframes tracer { to { stroke-dashoffset: 0; } }
  @keyframes emplir { to { fill-opacity: .13; } }

  @media (prefers-reduced-motion: reduce) {
    html.js .plaque .halo { stroke-dashoffset: 0; fill-opacity: .13; }
    html.js .plaque.vu .halo { animation: none; }
  }
</style>
