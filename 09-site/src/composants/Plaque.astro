---
/* Une planche : le plan de la ruche, cadre sur le lieu qu'on vient de lire.
   Elle vit dans le flux du texte, pleine largeur, sans cadre ni fond —
   comme une planche dans un livre, pas comme un encadre pose a cote. */
import ruche from '../../donnees/ruche.json';

const { lieu } = Astro.props;

const ATTRS_PORTES = new Set([
  'd', 'x', 'y', 'cx', 'cy', 'r', 'rx', 'ry', 'width', 'height', 'points', 'transform',
]);
const echapper = (v) => String(v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');

const halos = ruche.lieux.filter((z) => z.nom === lieu).map((z) => {
  const attrs = Object.entries(z.attrs)
    .filter(([k]) => ATTRS_PORTES.has(k))
    .map(([k, v]) => `${k}="${echapper(v)}"`).join(' ');
  return `<${z.tag} class="halo" pathLength="1" ${attrs}></${z.tag}>`;
}).join('');
---
<figure class="plaque" data-plaque data-lieu={lieu}>
  <div class="cadre">
    <svg viewBox={ruche.vue} preserveAspectRatio="xMidYMid slice" role="img" aria-label={`Le plan de la ruche, cadré sur : ${lieu}`}>
      <g class="vue" data-vue>
        <use href="#ruche" />
        <g class="halos" set:html={halos} />
      </g>
    </svg>
  </div>
  <figcaption>
    <span class="etiq">Le plan de la ruche</span>
    <b>{lieu}</b>
  </figcaption>
</figure>

<style>
  /* Plein ecran : la planche est un temps du recit, pas une illustration
     posee dans la marge. C'est le geste du livre — on tourne la page et
     il n'y a que ca. */
  .plaque {
    margin: 5rem 0;
    height: 100svh; min-height: 26rem;
    /* minmax(0, 1fr) : sans ca, la rangee se laisse pousser par la hauteur
       naturelle du dessin et la planche deborde de l'ecran. */
    display: grid; grid-template-rows: minmax(0, 1fr) auto;
    scroll-snap-align: center;
  }

  .cadre {
    min-height: 0;
    overflow: hidden;
    /* Les bords se fondent dans la page : pas de cadre, pas d'arete. */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent),
                        linear-gradient(#000, #000);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent);
  }
  .cadre svg { display: block; width: 100%; height: 100%; }

  /* Etat par defaut : tout est visible et en place. C'est le script qui
     commence par effacer, une fois qu'il a pris la main (data-prete).
     Sans JavaScript, la planche s'affiche entiere et lisible. */
  .vue {
    transform-origin: 0 0;
    transition: transform 1.6s cubic-bezier(.22, .9, .24, 1), opacity 1.2s ease-out;
  }
  :global(html.js) .plaque .vue { opacity: .35; }
  :global(html.js) .plaque.vu .vue { opacity: 1; }

  figcaption {
    display: flex; align-items: baseline; gap: 14px;
    max-width: var(--mesure); margin: 1.1rem auto 0; padding: 0 1.5rem;
  }
  figcaption b {
    font-family: var(--serif); font-size: 1.05rem; font-weight: 400;
    color: var(--accent);
  }
  figcaption .etiq, figcaption b {
    transition: opacity .8s 1.1s, transform .8s 1.1s;
  }
  :global(html.js) .plaque figcaption .etiq,
  :global(html.js) .plaque figcaption b { opacity: 0; transform: translateY(6px); }
  :global(html.js) .plaque.vu figcaption .etiq,
  :global(html.js) .plaque.vu figcaption b { opacity: 1; transform: none; }

  @media (max-width: 700px) {
    .plaque { margin: 3rem 0; height: 78svh; }
  }

  /* Sans le plein ecran (navigateurs anciens), on garde un cadre large. */
  @supports not (height: 100svh) {
    .plaque { height: auto; }
    .cadre { aspect-ratio: 16 / 7; }
  }

  @media (prefers-reduced-motion: reduce) {
    .vue, figcaption .etiq, figcaption b { transition: none; }
    :global(html.js) .plaque.vu .halo { animation: none; }
  }
</style>
