---
/* Le rail de l'atelier, reduit a ce qu'un lecteur a besoin de faire.
   Il persiste entre deux pages : la navigation ne le fait pas clignoter. */
const { vue } = Astro.props;
---
<nav class="rail" transition:persist aria-label="Navigation">
  <span class="sigle">L'Éclaircie</span>

  <a class={`rail-btn${vue === 'sommaire' ? ' on' : ''}`} href="/" aria-current={vue === 'sommaire' ? 'page' : undefined}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
    <span>Sommaire</span>
  </a>

  <a class={`rail-btn${vue === 'lecture' ? ' on' : ''}`} href="/lire/prologue/" aria-current={vue === 'lecture' ? 'page' : undefined}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H11v18H6.5A2.5 2.5 0 0 1 4 18.5zM20 5.5A2.5 2.5 0 0 0 17.5 3H13v18h4.5a2.5 2.5 0 0 0 2.5-2.5z"/></svg>
    <span>Lire</span>
  </a>

  <div class="bas">
    <button class="rail-btn" id="bascule-theme" type="button" aria-label="Changer de thème">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.2v2.4M12 19.4v2.4M2.2 12h2.4M19.4 12h2.4M5.1 5.1l1.7 1.7M17.2 17.2l1.7 1.7M18.9 5.1l-1.7 1.7M6.8 17.2l-1.7 1.7"/></svg>
      <span>Thème</span>
    </button>
  </div>
</nav>
